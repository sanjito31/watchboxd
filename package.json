{
  "name": "watchboxd",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:test": "tsx scripts/test-database.ts",
    "db:rehearse": "tsx scripts/rehearse-migrations.ts",
    "api:smoke": "node scripts/smoke-deployed-api.mjs",
    "watched:import": "node --import tsx scripts/import-watched-html.ts",
    "jobs:backfill-movies": "node --import tsx scripts/backfill-pending-movies.ts",
    "tmdb:backfill": "node --import tsx scripts/backfill-movie-metadata.ts"
  },
  "dependencies": {
    "@next/env": "16.3.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/queue": "0.4.0",
    "cheerio": "^1.2.0",
    "next": "^16.3.1",
    "pg": "8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  }
