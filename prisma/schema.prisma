model MovieAlias {
  slug    String @id
  movieId BigInt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId], map: "MovieAlias_movieId_idx")
}

model WatchlistItem {
  id       BigInt @id @default(autoincrement())
  userId   BigInt
  movieId  BigInt
  position Int

  user  LetterboxdUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie          @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId], map: "WatchlistItem_userId_movieId_key")
  @@index([userId, position], map: "WatchlistItem_userId_position_idx")
  @@index([movieId, userId], map: "WatchlistItem_movieId_userId_idx")
}

model WatchedItem {
  id          BigInt @id @default(autoincrement())
  userId      BigInt
  movieId     BigInt
  position    Int
  userRating  Float?

  user  LetterboxdUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie          @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId], map: "WatchedItem_userId_movieId_key")
  @@index([userId, position], map: "WatchedItem_userId_position_idx")
  @@index([movieId, userId], map: "WatchedItem_movieId_userId_idx")
}

model NetworkEdge {
  id           BigInt              @id @default(autoincrement())
  ownerId      BigInt
  memberId     BigInt
  relationship NetworkRelationship
  position     Int
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  owner  LetterboxdUser @relation("NetworkEdgeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member LetterboxdUser @relation("NetworkEdgeMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([ownerId, memberId], map: "NetworkEdge_ownerId_memberId_key")
  @@index([ownerId, relationship, position], map: "NetworkEdge_ownerId_relationship_position_idx")
  @@index([memberId], map: "NetworkEdge_memberId_idx")
}

model ScrapeJob {
  id             String                @id @default(uuid()) @db.Uuid
  environment    JobEnvironment
  type           ScrapeJobType
  resourceKey    String
  status         ScrapeJobStatus       @default(QUEUED)
  attempts       Int                   @default(0)
  queueMessageId String?               @unique(map: "ScrapeJob_queueMessageId_key")
  errorCode      ScrapeJobFailureCode?
  errorMessage   String?
  startedAt      DateTime?             @db.Timestamptz(3)
  finishedAt     DateTime?             @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)

  @@index([environment, type, resourceKey], map: "ScrapeJob_identity_idx")
  @@index([status, createdAt], map: "ScrapeJob_status_createdAt_idx")
}
