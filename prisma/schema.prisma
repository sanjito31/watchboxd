generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Migration strategy:
// - Use reviewed Prisma migrations; do not use db push.
// - Keep the partial unique index below in hand-authored SQL because Prisma
//   cannot express it:
//   CREATE UNIQUE INDEX "ScrapeJob_one_active_per_resource"
//   ON "ScrapeJob" ("environment", "type", "resourceKey")
//   WHERE "status" IN ('queued', 'running');
// - Enable RLS on every table with no public policies and revoke all privileges
//   from anon/authenticated. Prisma remains the only runtime database path.
// - Keep the model, enum, column, and explicit index names in this file stable.

enum MovieResolutionStatus {
  PENDING  @map("pending")
  RESOLVED @map("resolved")
  FAILED   @map("failed")
}

enum NetworkRelationship {
  MUTUAL    @map("mutual")
  FOLLOWING @map("following")
}

enum JobEnvironment {
  DEVELOPMENT @map("development")
  PREVIEW     @map("preview")
  PRODUCTION  @map("production")
}

enum ScrapeJobType {
  PROFILE   @map("profile")
  WATCHLIST @map("watchlist")
  WATCHED   @map("watched")
  NETWORK   @map("network")
  MOVIE     @map("movie")
}

enum ScrapeJobStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
}

enum ScrapeJobFailureCode {
  INVALID_INPUT        @map("invalid_input")
  NOT_FOUND            @map("not_found")
  UPSTREAM_UNAVAILABLE @map("upstream_unavailable")
  RATE_LIMITED         @map("rate_limited")
  TIMEOUT              @map("timeout")
  PARSE_ERROR          @map("parse_error")
  ATTEMPTS_EXHAUSTED   @map("attempts_exhausted")
  UNKNOWN              @map("unknown")
}

model LetterboxdUser {
  id          BigInt  @id @default(autoincrement())
  username    String  @unique(map: "LetterboxdUser_username_key")
  displayName String?
  avatarUrl   String?

  profileFetchedAt   DateTime? @db.Timestamptz(3)
  profileStaleAt     DateTime? @db.Timestamptz(3)
  watchlistFetchedAt DateTime? @db.Timestamptz(3)
  watchlistStaleAt   DateTime? @db.Timestamptz(3)
  watchedFetchedAt   DateTime? @db.Timestamptz(3)
  watchedStaleAt     DateTime? @db.Timestamptz(3)
  networkFetchedAt   DateTime? @db.Timestamptz(3)
  networkStaleAt     DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  watchlistItems     WatchlistItem[]
  watchedItems       WatchedItem[]
  ownedNetworkEdges  NetworkEdge[]   @relation("NetworkEdgeOwner")
  memberNetworkEdges NetworkEdge[]   @relation("NetworkEdgeMember")
}

model Movie {
  id               BigInt                @id @default(autoincrement())
  letterboxdSlug   String                @unique(map: "Movie_letterboxdSlug_key")
  letterboxdFilmId Int?                  @unique(map: "Movie_letterboxdFilmId_key")
  tmdbId           Int?                  @unique(map: "Movie_tmdbId_key")
  resolutionStatus MovieResolutionStatus @default(PENDING)
  
  title            String
  year             Int?
  letterboxdPoster String?
  letterboxdRating Float?

  letterboxdFetchedAt DateTime? @db.Timestamptz(3)
  letterboxdStaleAt   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // metadata       MovieMetadata?

  watchlistItems WatchlistItem[]
  watchedItems   WatchedItem[]
  aliases        MovieAlias[]

  @@index([resolutionStatus], map: "Movie_resolutionStatus_idx")
}

