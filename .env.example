# Supabase Postgres runtime connection (Supavisor transaction mode).
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres"
DATABASE_POOL_MAX="2"

# Direct or session-mode connection used only by Prisma migration tooling.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# Comma-separated browser origins allowed to read /api/v1.
API_ALLOWED_ORIGINS="http://localhost:3000"

# Optional: an isolated disposable database used by integration tests only.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST:5432/watchboxd_test"

# Vercel Queue authentication is supplied through Vercel OIDC. For local
# Queue smoke tests, run `vercel link` and `vercel env pull`; never commit the
# generated token or the .vercel directory.
